{
  "name": "kin-quiz-live",
  "version": "1.0.0",
  "private": true,
  "description": "Quiz live multijoueur sur la culture générale congolaise (React + Tailwind + Socket.io)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"node --watch server.js\" \"vite\"",
    "build": "vite build",
    "build:solo": "vite build -c vite.solo.config.js && node scripts/build-solo.mjs",
    "start": "node server.js",
    "build:pages": "vite build -c vite.solo.config.js && node scripts/finish-pages.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.3"
  }
}
